OPENAI_API_KEY=sk-your-key-here
# Production 500s unless one of these is set (or ALLOW_MOCK_SEARCH=1).
SERPAPI_API_KEY=
EXA_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
# Optional — raises GitHub Search API rate limits (60/hr unauthenticated)
GITHUB_TOKEN=
# FIRECRAWL_DISABLED=1
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# ALLOW_INMEMORY_LIMITS=1
# ALLOW_MOCK_SEARCH=1
# Dev-only: allow localStorage auth + IP quotas in production (not recommended)
# ALLOW_LOCAL_AUTH=1
NEXT_PUBLIC_SUPPORT_EMAIL=
# Later: move accounts + credits off the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key
# Names @supabase/server reads. Put the real values in .env.local.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# Dodo Payments test mode. Put the real test key in .env.local, not here.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_PRODUCT_ID=
DODO_PAYMENTS_CREDIT_PACK=5
# DODO_PAYMENTS_RETURN_URL=http://localhost:3000/checkout/success
# Google OAuth. Put the real values in .env.local, not here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

