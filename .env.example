# --- Required -------------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here
# Production refuses to start a run without live search.
SERPAPI_API_KEY=
EXA_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# --- Supabase (accounts + server-side credits) ----------------------------
# NEXT_PUBLIC_* are inlined at build time. Set them in the build environment,
# not just at runtime, or the browser falls back to local auth.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=your-secret-service-role-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# --- Redis (rate limits, daily run cap, research cache) -------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Hard ceiling on briefings started per UTC day across the deployment.
# 0 disables it (not recommended). Default 300.
GLOBAL_DAILY_RUN_LIMIT=300

# --- Dodo Payments --------------------------------------------------------
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
# One-time product, pay-what-you-want on, currency USD.
# Checkout sets the charge ($5, $12, or $24). That amount is ignored unless
# pay-what-you-want is on.
DODO_PAYMENTS_PRODUCT_ID=
# DODO_PAYMENTS_RETURN_URL=http://localhost:3000/checkout/success

# --- Auth providers -------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Search / scrape extras ----------------------------------------------
# Optional — raises GitHub Search API rate limits (60/hr unauthenticated)
GITHUB_TOKEN=
# FIRECRAWL_DISABLED=1

# --- Public copy ----------------------------------------------------------
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Local escape hatches (never set in production) -----------------------
# ALLOW_MOCK_SEARCH=1
# ALLOW_LOCAL_AUTH=1
# ALLOW_INMEMORY_LIMITS=1
